# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Database
DATABASE_PATH=./data/db.json

# JWT Authentication
JWT_SECRET=ai-saas-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AI Provider Configuration (OpenClaw v2026.3.11)
# Option 1: DashScope (Qwen) - Recommended for production
AI_PROVIDER=dashscope
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your-api-key-here

# Option 2: OpenRouter (with Hunter Alpha & Healer Alpha - free models!)
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-key
# ENABLE_HUNTER_ALPHA=true
# ENABLE_HEALER_ALPHA=true

# Stripe Billing (optional)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
FROM_EMAIL=noreply@yourplatform.com

# Security (OpenClaw v2026.3.11 - WebSocket origin validation)
CORS_ORIGINS=https://yourdomain.com,http://localhost:3000
CSRF_PROTECTION=true
SECURITY_HEADERS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Multimodal Memory (OpenClaw v2026.3.11 - Premium feature)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
# MEMORY_MULTIMODAL_ENABLED=true
