# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Database
DATABASE_PATH=./data/db.json

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# OpenClaw AI Integration
OPENCLAW_API_URL=http://localhost:8080
OPENCLAW_API_KEY=your-openclaw-api-key

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_BASIC=price_basic_tier
STRIPE_PRICE_PRO=price_pro_tier
STRIPE_PRICE_ENTERPRISE=price_enterprise_tier

# Email (SendGrid/Mailgun)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
FROM_EMAIL=noreply@yourplatform.com

# Custom Domains (for white-label)
CUSTOM_DOMAIN_ENABLED=true
SSL_CERT_PATH=./certs/

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90

# Security
CORS_ORIGINS=https://yourplatform.com,https://app.yourplatform.com
CSRF_PROTECTION=true
SECURITY_HEADERS=true
